rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Wishes collection: Anyone can read, anyone can submit a warm birthday wish
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isValidId(wishId)
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 2000
        && incoming().relation is string && incoming().relation.size() <= 100
        && (!('audioDataUrl' in incoming()) || (incoming().audioDataUrl is string && incoming().audioDataUrl.size() <= 500000));
      allow update, delete: if false;
    }

    // Birthday Cards collection: Anyone can read, anyone can add a celebration card, anyone can like
    match /birthday_cards/{cardId} {
      allow read: if true;
      allow create: if isValidId(cardId)
        && incoming().senderName is string && incoming().senderName.size() > 0 && incoming().senderName.size() <= 100
        && incoming().title is string && incoming().title.size() <= 150
        && incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 2000
        && incoming().photoUrl is string && incoming().photoUrl.size() <= 500000;
      allow update: if isValidId(cardId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
        && incoming().likes is number && incoming().likes >= existing().likes;
      allow delete: if false;
    }

    // Memory Pictures collection: Anyone can read, anyone can add a photo memory
    match /memory_pictures/{pictureId} {
      allow read: if true;
      allow create: if isValidId(pictureId)
        && incoming().url is string && incoming().url.size() > 0 && incoming().url.size() <= 500000
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150
        && incoming().note is string && incoming().note.size() <= 1500;
      allow update, delete: if false;
    }
  }
}
